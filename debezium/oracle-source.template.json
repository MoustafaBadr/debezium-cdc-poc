{
  "name": "oracle-source-connector",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",

    "database.hostname": "oracle-poc",
    "database.port": "1521",
    "database.user": "C##DBZUSER",
    "database.password": "__INJECT_AT_RUNTIME__",

    "database.dbname": "FREE",
    "database.pdb.name": "CDCDB",

    "database.connection.adapter": "logminer",
    "topic.prefix": "oracle-cdc",
    "snapshot.mode": "initial",

    "schema.include.list": "CDC_ADMIN",
    "table.include.list": "CDC_ADMIN.CUSTOMERS",

    "schema.history.internal.kafka.bootstrap.servers": "kafka:29092",
    "schema.history.internal.kafka.topic": "schema-changes.oracle-cdc"
  }
}
